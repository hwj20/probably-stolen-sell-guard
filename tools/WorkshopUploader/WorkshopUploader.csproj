<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <!-- 游戏的 *_Data 目录；装在别处时用 dotnet build -p:GameData="..." 覆盖 -->
  <PropertyGroup Condition="'$(GameData)' == ''">
    <GameData>C:\Program Files (x86)\Steam\steamapps\common\Probably Stolen\Probably Stolen_Data</GameData>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="com.rlabrecque.steamworks.net"><HintPath>$(GameData)\Managed\com.rlabrecque.steamworks.net.dll</HintPath></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameData)\Managed\UnityEngine.CoreModule.dll</HintPath></Reference>
    <None Include="$(GameData)\Plugins\x86_64\steam_api64.dll" CopyToOutputDirectory="PreserveNewest" Link="steam_api64.dll" />
  </ItemGroup>
</Project>
