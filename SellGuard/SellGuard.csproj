<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>SellGuard</AssemblyName>
    <RootNamespace>SellGuard</RootNamespace>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <!-- 游戏的 Managed 目录；装在别处时用 dotnet build -p:GameManaged="..." 覆盖 -->
  <PropertyGroup Condition="'$(GameManaged)' == ''">
    <GameManaged>C:\Program Files (x86)\Steam\steamapps\common\Probably Stolen\Probably Stolen_Data\Managed</GameManaged>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(GameManaged)\Assembly-CSharp.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(GameManaged)\UnityEngine.CoreModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(GameManaged)\UnityEngine.InputLegacyModule.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameManaged)\0Harmony.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>

  <!-- 构建后把可直接放进 Mods 的文件夹整理到 bin/<配置>/mod/SellGuard -->
  <Target Name="PackageMod" AfterTargets="Build">
    <PropertyGroup>
      <ModOut>$(MSBuildProjectDirectory)\bin\$(Configuration)\mod\SellGuard</ModOut>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath);manifest.xml;preview.png" DestinationFolder="$(ModOut)" />
    <Message Importance="high" Text="Mod folder: $(ModOut)" />
  </Target>
</Project>
